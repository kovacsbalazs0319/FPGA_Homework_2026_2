# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y2 [get_cells hdmi_rx_0/BUF_fastclk]
set_property LOC BUFGCTRL_X0Y0 [get_cells hdmi_rx_0/BUF_slowclk]
set_property LOC BUFGCTRL_X0Y1 [get_cells BUFG_200M]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y78 [get_ports clk100M]
set_property LOC IOB_X0Y71 [get_ports hdmi_rx_clk_n]
set_property LOC IOB_X0Y72 [get_ports hdmi_rx_clk_p]

# Clock net "hdmi_rx_0/rx_clk_5x" driven by instance "hdmi_rx_0/BUF_fastclk" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_hdmi_rx_0/rx_clk_5x}
add_cells_to_pblock [get_pblocks  {CLKAG_hdmi_rx_0/rx_clk_5x}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="hdmi_rx_0/rx_clk_5x"}]]]
resize_pblock [get_pblocks {CLKAG_hdmi_rx_0/rx_clk_5x}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "hdmi_rx_0/rx_clk" driven by instance "hdmi_rx_0/BUF_slowclk" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_hdmi_rx_0/rx_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_hdmi_rx_0/rx_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="hdmi_rx_0/rx_clk"}]]]
resize_pblock [get_pblocks {CLKAG_hdmi_rx_0/rx_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup

# Clock net "clk_200M" driven by instance "BUFG_200M" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_clk_200M}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_200M}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="clk_200M"}]]]
resize_pblock [get_pblocks {CLKAG_clk_200M}] -add {CLOCKREGION_X0Y1:CLOCKREGION_X0Y1}
#endgroup
